rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prototyyppi: sovellus käyttää Firebase Anonymous Authenticationia.
    // Pelaajan ääntä tai taajuuksia ei tallenneta Firestoreen.
    match /groups/{groupId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;

      match /slots/{slotId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40
          && request.resource.data.animal in ['dog','fox','rabbit','owl','panda']
          && request.resource.data.code in ['LLH','LHL','LHH','HLL','HLH','HHL']
          && request.resource.data.verified == false;

        allow update, delete: if request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
