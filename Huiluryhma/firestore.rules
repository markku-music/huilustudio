rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function validSlot() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.animal in ['dog','fox','rabbit','owl','panda']
        && request.resource.data.code in ['LLH','LHL','LHH','HLL','HLH','HHL'];
    }

    // Opettajaluettelo on palvelimen käyttöoikeuslista.
    // Opettaja voi lukea vain oman teachers/{uid}-merkintänsä.
    // Selain ei voi luoda, muuttaa tai poistaa opettajamerkintöjä.
    match /teachers/{teacherId} {
      allow get: if signedIn() && request.auth.uid == teacherId;
      allow list, create, update, delete: if false;
    }

    match /groups/{groupId} {
      // Pelaajasovellus tarvitsee yksittäisen ryhmän luvun profiilin luonnissa.
      allow get: if signedIn();

      // Koko ryhmälistan saa nähdä vain opettaja.
      allow list: if isTeacher();

      // Pelaaja saa luoda uuden ryhmän vain omalla UID:llään.
      // Opettaja saa luoda ryhmiä hallintanäkymästä.
      allow create: if isTeacher()
        || (signedIn() && request.resource.data.createdBy == request.auth.uid);

      allow update, delete: if isTeacher();

      match /slots/{slotId} {
        // Pelaajan kirjautuminen tekee yhden tarkan document get -haun.
        allow get: if signedIn();

        // Jäsenlistan selaus kuuluu vain opettajalle.
        allow list: if isTeacher();

        allow create: if validSlot() && (
          isTeacher()
          || (
            signedIn()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.verified == false
          )
        );

        // Opettaja saa muokata kaikkia profiileja.
        // Pelaaja saa vain vahvistaa itse juuri luomansa profiilin.
        allow update: if isTeacher()
          || (
            signedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified','verifiedAt'])
            && request.resource.data.verified == true
          );

        // Opettaja saa poistaa profiileja. Pelaaja saa vapauttaa vain
        // oman vielä vahvistamattoman varauksensa.
        allow delete: if isTeacher()
          || (
            signedIn()
            && resource.data.ownerUid == request.auth.uid
            && resource.data.verified == false
          );
      }
    }
  }
}
