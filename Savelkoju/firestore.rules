rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /publicPlayers/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /players/{uid} {
      allow create, read, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      match /sessions/{sessionId} {
        allow create: if isOwner(uid) || isAdmin();
        allow read, update, delete: if isAdmin();
      }
    }
    match /playerCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }
    match /admins/{uid} { allow read: if isOwner(uid); allow write: if false; }
    match /gameConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      match /items/{itemId} { allow read: if true; allow write: if isAdmin(); }
    }
  }
}